# Lumenore MCP Server configuration
# Copy this file to .env and fill in your own values. Never commit .env.

# Lumenore backend base URL
SERVER_URL=https://your-lumenore-host.example.com

# --- OAuth protected-resource metadata (public URLs, not localhost) ---
# Issuer URL of the Lumenore identity provider
AUTHORIZATION_SERVER_ISSUER=https://your-lumenore-host.example.com/api/secure
# Public URL of this MCP endpoint (the gateway URL when a gateway fronts /mcp)
MCP_RESOURCE_URL=https://your-lumenore-host.example.com/api/mcp-server/mcp
# Scopes accepted by the MCP OAuth flow
MCP_SCOPES=mcp.tools,lumenore

# --- Optional server-level credentials ---
# Leave empty for multi-tenant / public deployments. When set, requests
# without their own credentials run as this account and /mcp does not
# require OAuth.
# LUMENORE_API_KEY=
# LUMENORE_CLIENT_ID=
# LUMENORE_SECRET=
# In server-credential mode /mcp only accepts these Host / Origin values, plus
# loopback names and the MCP_RESOURCE_URL host ("*" disables the check).
# ALLOWED_HOSTS=
# ALLOWED_ORIGINS=

# --- File uploads (publish-api) ---
PUBLISH_API_BASE_URL=https://your-lumenore-host.example.com/api/publish
PUBLISH_API_SESSIONS_PATH=/signed/sessions
# Optional server-level bearer for publish-api (leave empty for multi-tenant).
# Counts as a server-level credential.
PUBLISH_API_TOKEN=
# Public URL of the browser upload page (defaults to MCP_RESOURCE_URL with /mcp -> /upload)
UPLOAD_PAGE_BASE_URL=
# Hosts the upload page may send files to (defaults to the PUBLISH_API_BASE_URL host)
UPLOAD_PAGE_ALLOWED_HOSTS=
# Optional allowlist of hosts for upload_file_from_url (empty = any public HTTPS host)
ALLOWED_SOURCE_URL_HOSTS=
# upload_file_from_url: simultaneous downloads and total seconds per download
UPLOAD_FROM_URL_MAX_CONCURRENCY=2
UPLOAD_FROM_URL_TIMEOUT_SECONDS=300
MAX_INLINE_BYTES=102400
MAX_CHUNK_BYTES=30000
MAX_TOTAL_BYTES=104857600
UPLOAD_URL_CACHE_TTL_SECONDS=600
CHUNK_NUMBER_START=0
ENABLE_HANDOFF_TOOLS=false
ALLOWED_EXTENSIONS=
DEFAULT_UPLOAD_DESTINATION=Lumenore

# --- Routing ---
# Leave empty if the gateway strips the path prefix; otherwise set it,
# e.g. BASE_PATH=/bridge/lumenore-mcp
# BASE_PATH=

# --- Logging ---
DEBUG=false
# Optional path for a rotating log file (stderr only when empty)
# LOG_FILE=
